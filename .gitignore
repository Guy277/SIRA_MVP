# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
**/dist/
**/__pycache__/
**/.venv/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# datasets & heavy archives
data/
*.zip
*.apk

# modèles d'IA des services (services/models/) — jamais dans Git, sauf le README
services/models/*
!services/models/README.md

# local databases and development signing key (community service in development)
*.db
services/community/data/dev-jwt-secret

# espaces de travail d'éditeur
.kilo/
