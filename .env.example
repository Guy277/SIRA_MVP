NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT=4000
DATABASE_URL=postgresql://sira:sira_dev_password@localhost:5432/sira
VALKEY_URL=redis://localhost:6379/0
VALHALLA_URL=http://localhost:8002
SIRA_ALLOW_ESTIMATED_WALK_CONNECTORS=false
SIRA_ROUTING_CLIENT_ID=github.com/Guy277/SIRA_MVP
PHOTON_URL=https://photon.komoot.io
AI_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Service communautaire (comptes par SMS, tarifs communautaires)
COMMUNITY_URL=http://localhost:8100
# development : code SMS renvoyé par l'API pour les démos ; production : SMS obligatoire
SIRA_ENV=development
# Obligatoire en production (au moins 32 caractères aléatoires). Ne jamais commiter la vraie valeur.
COMMUNITY_JWT_SECRET=
# Orange Developer API (SMS Côte d'Ivoire). À remplir uniquement dans .env, jamais dans Git.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
