# Appli mobile (mobile/) : adresse de l'API. Vide en développement (l'appli la trouve seule : même PC,
# ou le PC qui fait tourner Expo pour Expo Go). À définir pour un export web ou un serveur, avec une
# adresse COMPLÈTE (ex. https://sira.example.ci/api/v1) : l'appli en déduit l'adresse des signalements en direct.
# EXPO_PUBLIC_API_URL=

# API (services/api)
PORT=4000
DATABASE_URL=postgresql://sira:sira_dev_password@localhost:5432/sira
VALKEY_URL=redis://localhost:6379/0
VALHALLA_URL=http://localhost:8002
SIRA_ALLOW_ESTIMATED_WALK_CONNECTORS=false
SIRA_ROUTING_CLIENT_ID=github.com/Guy277/SIRA_MVP
PHOTON_URL=https://photon.komoot.io
# SIRA-MORE (services/engine) ; le nom de la variable est historique
AI_URL=http://localhost:8000
# Appli dans le navigateur : 8081 (Expo), 8080 (export web derrière Nginx)
CORS_ORIGIN=http://localhost:8081,http://localhost:8080

# Service communautaire (comptes par SMS, tarifs communautaires)
COMMUNITY_URL=http://localhost:8100

# Assistant vocal (services/voice) : npm run voice:setup puis npm run dev:stack
VOICE_URL=http://localhost:8200
# small (rapide, CPU) ou turbo (plus précis) ; large-v3 seulement avec un GPU
VOICE_WHISPER_MODEL=small
# Précision de Whisper : 5 (défaut, plus sûr sur les noms de lieux) ou 1 (≈ 20 % plus rapide, moins précis)
# VOICE_WHISPER_BEAM=5
# Vitesse de la voix de SIRA : 1.0 = voix d'origine, 1.1 (défaut) = 10 % plus rapide
# VOICE_SPEECH_RATE=1.1
# 0 = charger Whisper et Piper à la première demande au lieu du démarrage (démarrage plus léger, 1re réponse plus lente)
# VOICE_PRELOAD=1
# Réserve de modèles de la voix (par défaut services/models/voice, voir services/models/README.md)
# VOICE_MODELS_ROOT=
# Modèles entraînés sur Colab (par défaut services/models/voice/sira_models_v0.4)
# VOICE_MODELS_DIR=
# FAQ de SIRA (services/voice/knowledge) : score minimum pour qu'une fiche réponde (0 à 1)
# VOICE_FAQ_THRESHOLD=0.65
# development : code SMS renvoyé par l'API pour les démos ; production : SMS obligatoire
SIRA_ENV=development
# Obligatoire en production (au moins 32 caractères aléatoires). Ne jamais commiter la vraie valeur.
COMMUNITY_JWT_SECRET=
# Orange Developer API (SMS Côte d'Ivoire). À remplir uniquement dans .env, jamais dans Git.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
