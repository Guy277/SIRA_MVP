{
  "expo": {
    "name": "SIRA",
    "slug": "sira_proj",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siraproj",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "lang": "fr",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sira-logo-white-designer.png",
          "imageWidth": 173,
          "resizeMode": "contain",
          "backgroundColor": "#010101",
          "dark": {
            "backgroundColor": "#010101"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SIRA utilise ta position pour calculer les trajets depuis l'endroit où tu es et pour localiser tes signalements."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "SIRA utilise le micro pour comprendre ta destination quand tu parles. Aucun enregistrement n'est conservé."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
