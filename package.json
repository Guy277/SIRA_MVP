{
  "name": "sira",
  "displayName": "SIRA",
  "description": "SIRA — mobilité du Grand Abidjan : lancement de la stack (appli Expo, API, SIRA-MORE, comptes, voix) et outils de données.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:stack": "node scripts/start-dev-stack.mjs",
    "test:runtime": "node scripts/start-dev-stack.mjs --smoke-test",
    "test": "node --test tests/*.test.mjs",
    "test:ai": "py -3 -m unittest discover -s services/engine/tests -v",
    "test:community": "node scripts/test-community.mjs",
    "voice:setup": "node scripts/setup-voice.mjs",
    "dev:voice": "node scripts/setup-voice.mjs --run",
    "test:voice": "node scripts/setup-voice.mjs --test",
    "test:routing:live": "node scripts/validate-valhalla-live.mjs",
    "test:integration": "node --test tests/*.test.mjs",
    "data:audit": "node scripts/audit-transport-data.mjs",
    "data:audit:network": "node scripts/audit-transport-network.mjs",
    "data:normalize": "node scripts/normalize-transport-data.mjs",
    "data:pilot": "node scripts/generate-pilot-corridors.mjs",
    "data:import": "node scripts/import-transport-postgis.mjs",
    "data:import:postgis": "node scripts/import-transport-postgis-db.mjs",
    "data:audit:postgis": "node scripts/audit-transport-postgis.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
