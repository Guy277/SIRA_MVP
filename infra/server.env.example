# Serveur de test SIRA (EC2) : modèle de infra/server.env.
# scripts/server/install.sh copie ce fichier en infra/server.env (jamais dans Git) et remplit tout seul
# les valeurs vides marquées « auto ». Les autres sont à remplir à la main si besoin.

# Adresse publique du serveur, sans https:// ni chemin.
# auto : <IP publique avec des tirets>.sslip.io (ex. 13-51-20-30.sslip.io), à condition d'avoir une IP fixe
# (Elastic IP) : si l'IP change, l'adresse change et l'appli doit être reconstruite.
# Avec un domaine de l'entreprise : test.sira.ci (enregistrement DNS A vers l'IP du serveur).
SIRA_DOMAIN=

# auto : 32 octets aléatoires en hexadécimal. Lettres et chiffres seulement (il entre dans une URL).
# Pris en compte à la création de la base seulement : le changer ensuite ne change pas la base.
POSTGRES_PASSWORD=

# auto : 32 octets aléatoires en hexadécimal. Signe les sessions des voyageurs.
COMMUNITY_JWT_SECRET=

# production : connexion par SMS Orange obligatoire (remplir ORANGE_*), aucun code renvoyé par l'API.
# development : le code SMS est renvoyé par l'API. Pratique pour une démo, mais sur un serveur public
# n'importe qui peut alors créer un compte avec n'importe quel numéro.
SIRA_ENV=production

# Orange Developer API (SMS Côte d'Ivoire), seulement en production.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=

# small (conseillé sur t3.large / t3.xlarge sans GPU) ou turbo (plus précis, plus lent).
VOICE_WHISPER_MODEL=small

# Page de suivi https://<SIRA_DOMAIN>/statut/ (utilisateur « sira »).
# auto : mot de passe aléatoire, et son empreinte bcrypt en base64 pour Caddy. Pour changer le mot de passe :
# le remplacer, vider SIRA_STATUS_HASH, relancer le script.
SIRA_STATUS_PASSWORD=
SIRA_STATUS_HASH=
